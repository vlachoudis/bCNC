#version 120

attribute float index;

uniform mat4 MVP;

uniform sampler2D heightMap;

uniform vec3 stockMin;
uniform vec3 stockMax;

varying vec2 uv;

void main() {
    if (index == 1.)
    {
        uv = vec2(0., 0.);
        gl_Position = MVP * vec4(stockMin, 1.);
    }
    else if (index == 2.)
    {
        uv = vec2(1., 0.);
        gl_Position = MVP * vec4(stockMax.x, stockMin.y, stockMin.z, 1.);
    }
    else if (index == 3.)
    {
        uv = vec2(1., 1.);
        gl_Position = MVP * vec4(stockMax.x, stockMax.y, stockMin.z, 1.);
    }
    else if (index == 4.)
    {
        uv = vec2(0., 1.);
        gl_Position = MVP * vec4(stockMin.x, stockMax.y, stockMin.z, 1.);
    }
}
